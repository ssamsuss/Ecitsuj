{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeliberationTurn",
  "type": "object",
  "additionalProperties": false,
  "required": ["message", "cited_evidence_codes", "stance"],
  "properties": {
    "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "cited_evidence_codes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^E[0-9]+$" },
      "uniqueItems": true
    },
    "stance": { "type": "string", "enum": ["support", "challenge", "clarify"] }
  }
}