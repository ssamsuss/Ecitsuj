{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case_packet.schema.json",
  "title": "CasePacket",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "facts", "jury_instructions", "evidence_items"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "jurisdiction": { "type": ["string", "null"] },
    "charge": { "type": ["string", "null"] },
    "standard_of_proof": { "type": "string", "minLength": 1 },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "jury_instructions": { "type": "string", "minLength": 1 },
    "evidence_items": {
      "description": "Evidence codes must be unique. JSON Schema uniqueItems only compares complete objects, so runtime consumers must use the Pydantic CasePacketIn validator for code-level uniqueness.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "kind", "content"],
        "properties": {
          "code": { "type": "string", "pattern": "^E[0-9]+$" },
          "kind": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 },
          "metadata": { "type": "object" }
        }
      },
      "uniqueItems": true
    }
  }
}
