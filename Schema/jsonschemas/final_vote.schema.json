{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinalVote",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "confidence", "rationale", "what_changed", "cited_evidence_codes"],
  "properties": {
    "verdict": { "type": "string", "enum": ["guilty", "not_guilty", "undecided"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "what_changed": { "type": "string", "minLength": 1, "maxLength": 800 },
    "cited_evidence_codes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^E[0-9]+$" },
      "uniqueItems": true
    }
  }
}