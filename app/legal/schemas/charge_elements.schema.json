{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "charge_elements.schema.json",
  "title": "ChargeElements",
  "type": "object",
  "additionalProperties": false,
  "required": ["jurisdiction", "charge", "standard_of_proof", "elements"],
  "properties": {
    "jurisdiction": { "type": "string", "pattern": "^[a-z]{2}-[a-z-]+$" },
    "charge": { "type": "string", "minLength": 1 },
    "statute_reference": { "type": ["string", "null"] },
    "standard_of_proof": { "type": "string", "minLength": 1 },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
